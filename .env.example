# AlgorithmHot 本地配置参考。推荐 node scripts/local.ts init 自动生成私有 .env 和随机密钥。
# 不要先复制本示例覆盖 .env：下面的空密钥不能用于启动，init 保留已有配置。
# 不要提交 .env、数据库密码、账户凭据或运行回执。

# 本机阅读地址；local start 会避让占用端口并同步这四项。
SITE_URL=http://127.0.0.1:3100
API_BASE_URL=http://127.0.0.1:3101
WEB_PORT=3100
API_PORT=3101
WEB_HOST=127.0.0.1
API_HOST=127.0.0.1
AIHOT_ENVIRONMENT=local
TRUST_PROXY=false
ALLOW_PRIVATE_NETWORK_FETCH=false

# 由 local init 生成 DATABASE_URL 与下列随机密钥。
# 专用 PostgreSQL 17 在 127.0.0.1:55432，用户/数据库为 algorithmhot。
# DATABASE_URL=postgres://algorithmhot:<local-password>@127.0.0.1:55432/algorithmhot
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# 默认路线：复用指定 Codex CLI 的现有 ChatGPT 登录，不需要付费 API key。
# 不自动切换账户或回退到 API。更改模型后以小样本实际回执确认可用性。
LLM_TRANSPORT=codex_cli
CODEX_BIN=/opt/homebrew/bin/codex
CODEX_MODEL=gpt-6-astra
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=180000
LLM_MODEL=gpt-6-astra

# Agent 接入页的「调研模型」由管理员选择，新研究批次保存固定配置。
# 可选 Codex GPT-6 Astra / GPT-6.1 Sol；已有批次恢复时沿用原配置和预算。
# Bedrock 仅在明确选择且账户/地区可用时启用，按 token 计费；不自动回退。
# 凭据仅放后端环境或 models.env，不能填入网页、提交仓库或静态导出。
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=global.openai.gpt-6-astra
# BEDROCK_TIMEOUT_MS=120000

# 只有显式选择 OpenAI 兼容 API 时才配置；可能产生服务商费用。
# LLM_TRANSPORT=openai_compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-id
# LLM_EXTRA_JSON={}
# LLM_JSON_MODE=true

# 正常阅读模式：禁用采集、模型、向量、推送及搜索引擎提交。
# local run / daily 仅在对应批次子进程显式开启采集和模型。
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
EMBEDDINGS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false

# 研究准入与报告保护保持启用；它们不是执行开关。
# 来源默认 enabled=false；worker 与调度不会由 local start 自动启动。
RESEARCH_ADMISSION_ENABLED=true
RESEARCH_REPORTS_ENABLED=true
RESEARCH_ON_DEMAND=true
ANALYZE_CONCURRENCY=1
SELECTED_VISIBLE_AFTER_SECONDS=0

# 批次额度持久化：已存在批次不能靠重启提高额度。
# MODEL_RUN_ID 由 local run / daily 提供，不要在全局 .env 固定。
MODEL_RUN_MAX_CALLS=600
MODEL_RUN_REPORT_RESERVE=20

# 可选网络代理；不含账户凭据。
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 可选运行数据目录，默认 app/.data；不要指向公开静态目录。
# AIHOT_DATA_DIR=
