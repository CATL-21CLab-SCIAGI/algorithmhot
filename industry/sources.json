{
  "$comment": "AlgorithmHot 的示范信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。之后在后台“信源”里新建、修改和暂停。字段说明见 docs/customize.md。这里只放引擎能直接采集的来源；arXiv 与期刊（经 Crossref）由研究来源模块读取 industry/research-feeds.json。",
  "sources": [
    {
      "id": "rss-google-deepmind",
      "name": "Google DeepMind",
      "kind": "rss",
      "config": {
        "feedUrl": "https://deepmind.google/blog/rss.xml",
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "owner_entity_id": "google",
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": [
        "机构"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "rss-bair",
      "name": "Berkeley BAIR",
      "kind": "rss",
      "config": {
        "feedUrl": "https://bair.berkeley.edu/blog/feed.xml",
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "owner_entity_id": "bair",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [
        "机构"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "json-hf-daily-papers",
      "name": "Hugging Face Daily Papers",
      "kind": "json_list",
      "config": {
        "url": "https://huggingface.co/api/daily_papers",
        "mode": "json_api",
        "titlePaths": [
          "paper.title",
          "title"
        ],
        "summaryPaths": [
          "paper.summary",
          "summary"
        ],
        "summaryIsBody": true,
        "urlTemplate": "https://arxiv.org/abs/{paper.id}",
        "publishedAtPath": "paper.submittedOnDailyAt",
        "externalIdPath": "paper.id",
        "_aihot": {
          "initialBackfillLimit": 30
        }
      },
      "tier": "T1_5",
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": [
        "社区"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    }
  ]
}
