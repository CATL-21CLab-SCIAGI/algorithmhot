    {
      "itemId": "cizihtr8eoatg0vtfkhh69x9r",
      "sourceRevision": 1,
      "imageOrigin": "remote",
      "imageUrl": "https://arxiv.org/html/2609.06874v1/overview_V3.png",
      "sourceUrl": "https://arxiv.org/html/2609.06874v1#S3.F2",
      "figureLabel": "原文 Figure 2",
      "caption": "Figure 2: Overview of MedGSSR. Given an LR input volume, the Pyramid Anatomical Encoder (PAE) built on a 3D U-Net extracts a coarse feature map and a 2\\times upsampled fine feature map via input-residual connection and PixelShuffle. The Hierarchical Gaussian Projector (HGP) performs sub-voxel Gaussian decomposition by predicting multiple Gaussian primitives per voxel with lightweight MLP heads, producing structural Gaussians from the coarse stream and textural Gaussians from the fine stream. These primitives are then aggregated by the Differentiable Gaussian Voxelizer (DGV) through differentiable rasterization to form a continuous volumetric intensity field, from which the HR volume is rendered.",
      "attribution": "Wang, Chengkai; Hong, Luoyu; Zhao, Yiting et al. · MedGSSR: Generalizable Medical Image Super-Resolution 3D Reconstruction via Hierarchical Feed-forward Gaussian Splatting (arXiv v1)",
      "licenseName": "CC BY 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
